{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pier",
	"version": "../package.json",
	"identifier": "dev.pier.desktop",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run sidecar && bun run build:web",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "Pier",
				"width": 1280,
				"height": 820,
				"minWidth": 860,
				"minHeight": 560,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:*",
				"img-src": "'self' data: blob:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "Desktop dock and mobile remote for coding agents",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"externalBin": ["binaries/pier-host"],
		"resources": { "pi-assets/": "pi-assets/" },
		"createUpdaterArtifacts": true,
		"windows": {
			"nsis": {
				"languages": ["English", "SimpChinese", "TradChinese"],
				"displayLanguageSelector": false
			}
		},
		"macOS": {
			"signingIdentity": "-",
			"infoPlist": "Info.plist",
			"entitlements": "entitlements.plist"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjQwOEEyOThFMUJERkYKUldUL3ZlR1lvZ2owemVUKy9XcjVDbk9GMWFCOEx1MERTdHF3RjdUOTJSSU10U2lKT0JRbEZrK2QK",
			"endpoints": ["https://github.com/yiranxiaohui/Pier/releases/latest/download/latest.json"],
			"windows": { "installMode": "passive" }
		}
	}
}
